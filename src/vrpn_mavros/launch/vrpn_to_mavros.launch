<?xml version="1.0"?>
<launch>
  <arg name="vrpn_server" default="192.168.3.37"/>
  <arg name="vrpn_port" default="3883"/>
  <arg name="vrpn_frequency" default="100.0"/>
  <arg name="tracker" default="pend_h1"/>
  <arg name="frame_id" default="map"/>
  <arg name="fcu_url" default="udp://:14560@192.168.3.109:14550"/>
  <arg name="gcs_url" default=""/>
  <arg name="tgt_system" default="1"/>
  <arg name="tgt_component" default="1"/>
  <arg name="use_mocap" default="false"/>
  <arg name="enable_twist" default="true"/>
  <arg name="scale" default="1.0"/>

  <node pkg="vrpn_mocap" exec="vrpn_tracker_node" name="$(var tracker)" output="screen">
    <param name="server" value="$(var vrpn_server)"/>
    <param name="port" value="$(var vrpn_port)"/>
    <param name="tracker_name" value="$(var tracker)"/>
    <param name="frame_id" value="mocap_flu"/>
    <param name="use_server_time" value="false"/>
    <param name="broadcast_tf" value="false"/>
    <param name="update_frequency" value="$(var vrpn_frequency)"/>
  </node>

  <node pkg="vrpn_mavros" exec="vrpn_flu_to_enu.py" name="vrpn_flu_to_enu" output="screen">
    <param name="frame_id" value="$(var frame_id)"/>
    <param name="input_topic" value="/$(var tracker)/pose"/>
    <param name="output_topic" value="/vrpn_enu/pose"/>
    <param name="twist_input_topic" value="/$(var tracker)/twist"/>
    <param name="twist_output_topic" value="/vrpn_enu/twist"/>
    <param name="enable_twist" value="$(var enable_twist)"/>
    <param name="scale" value="$(var scale)"/>
  </node>

  <include file="$(find-pkg-share mavros)/launch/node.launch">
    <arg name="pluginlists_yaml" value="$(find-pkg-share vrpn_mavros)/launch/apm_pluginlists.yaml"/>
    <arg name="config_yaml" value="$(find-pkg-share mavros)/launch/apm_config.yaml"/>
    <arg name="fcu_url" value="$(var fcu_url)"/>
    <arg name="gcs_url" value="$(var gcs_url)"/>
    <arg name="tgt_system" value="$(var tgt_system)"/>
    <arg name="tgt_component" value="$(var tgt_component)"/>
  </include>

  <node pkg="topic_tools" exec="relay" name="vrpn_to_vision_pose"
        args="/vrpn_enu/pose /mavros/vision_pose/pose" unless="$(var use_mocap)" output="screen"/>
  <node pkg="topic_tools" exec="relay" name="vrpn_to_mocap_pose"
        args="/vrpn_enu/pose /mavros/mocap/pose" if="$(var use_mocap)" output="screen"/>
  <node pkg="topic_tools" exec="relay" name="vrpn_to_vision_speed"
        args="/vrpn_enu/twist /mavros/vision_speed/speed_twist" if="$(var enable_twist)" output="screen"/>
</launch>
