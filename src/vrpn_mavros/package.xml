<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>vrpn_mavros</name>
  <version>0.1.0</version>
  <description>
    Bridge Motive/VRPN motion-capture poses/twists into MAVROS for ArduPilot.
    将 Motive/VRPN 动捕位姿与速度桥接到 MAVROS，供 ArduPilot 使用。
    Forwards SI-unit ENU poses and twists to vision_pose / vision_speed (or mocap).
  </description>
  <maintainer email="luweilia@users.noreply.github.com">LuweiLiao</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>topic_tools</exec_depend>
  <exec_depend>vrpn_mocap</exec_depend>
  <exec_depend>mavros</exec_depend>
  <exec_depend>mavros_extras</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
