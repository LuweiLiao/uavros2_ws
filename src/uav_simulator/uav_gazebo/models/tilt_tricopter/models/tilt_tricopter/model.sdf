    <commandSubTopic>/gazebo/command/prop_speed</commandSubTopic>
    <motorNumber>3</motorNumber>
    <rotorDragCoefficient>0.000806428</rotorDragCoefficient>
    <rollingMomentCoefficient>1e-06</rollingMomentCoefficient>
    <motorSpeedPubTopic>prop_speed/3</motorSpeedPubTopic>
    <rotorVelocitySlowdownSim>10</rotorVelocitySlowdownSim>
  </plugin>

  <include>
    <uri>model://tilt_tricopter_prop</uri>
    <name>tilt_tricopter_prop_4</name>
    <pose>0.7 0.7 0.0647 0 0 0</pose>
  </include>
  <joint name="tilt_tricopter_prop_4_joint" type="revolute">
    <parent>tilt_tricopter_tilt_front_1::tilt</parent>
    <child>tilt_tricopter_prop_4::prop</child>
    <axis>
      <xyz>0 0 1</xyz>
      <limit>
        <lower>-1e+16</lower>
        <upper>1e+16</upper>
      </limit>
      <dynamics>
        <damping>0.0001</damping>
      </dynamics>
      <use_parent_model_frame>1</use_parent_model_frame>
    </axis>
  </joint>
  <plugin name = "prop_4_plugin" filename='librotors_gazebo_motor_model.so'>
    <robotNamespace></robotNamespace>
    <jointName>tilt_tricopter_prop_4_joint </jointName>
    <linkName>tilt_tricopter_prop_4::prop</linkName>
    <turningDirection>ccw</turningDirection>
    <timeConstantUp>0.0125</timeConstantUp>
    <timeConstantDown>0.025</timeConstantDown>
    <maxRotVelocity>1000</maxRotVelocity>
    <motorConstant>1.199e-05</motorConstant>
    <momentConstant>0.1</momentConstant>
    <commandSubTopic>/gazebo/command/prop_speed</commandSubTopic>
    <motorNumber>4</motorNumber>
    <rotorDragCoefficient>0.000806428</rotorDragCoefficient>
    <rollingMomentCoefficient>1e-06</rollingMomentCoefficient>
    <motorSpeedPubTopic>prop_speed/4</motorSpeedPubTopic>
    <rotorVelocitySlowdownSim>10</rotorVelocitySlowdownSim>
  </plugin>

  <include>
    <uri>model://tilt_tricopter_prop</uri>
    <name>tilt_tricopter_prop_5</name>
    <pose>0.7 0.7 -0.0647 0 0 0</pose>
  </include>
  <joint name="tilt_tricopter_prop_5_joint" type="revolute">
    <parent>tilt_tricopter_tilt_front_1::tilt</parent>
    <child>tilt_tricopter_prop_5::prop</child>
    <axis>
      <xyz>0 0 1</xyz>
      <limit>
        <lower>-1e+16</lower>
        <upper>1e+16</upper>
      </limit>
      <dynamics>
        <damping>0.0001</damping>
      </dynamics>
      <use_parent_model_frame>1</use_parent_model_frame>
    </axis>
  </joint>
  <plugin name = "prop_5_plugin" filename='librotors_gazebo_motor_model.so'>
    <robotNamespace></robotNamespace>
    <jointName>tilt_tricopter_prop_5_joint </jointName>
    <linkName>tilt_tricopter_prop_5::prop</linkName>
    <turningDirection>cw</turningDirection>
    <timeConstantUp>0.0125</timeConstantUp>
    <timeConstantDown>0.025</timeConstantDown>
    <maxRotVelocity>1000</maxRotVelocity>
    <motorConstant>1.199e-05</motorConstant>
    <momentConstant>0.1</momentConstant>
    <commandSubTopic>/gazebo/command/prop_speed</commandSubTopic>
    <motorNumber>5</motorNumber>
    <rotorDragCoefficient>0.000806428</rotorDragCoefficient>
    <rollingMomentCoefficient>1e-06</rollingMomentCoefficient>
    <motorSpeedPubTopic>prop_speed/5</motorSpeedPubTopic>
    <rotorVelocitySlowdownSim>10</rotorVelocitySlowdownSim>
  </plugin>


<!-- Gazebo Sim's official replacement for the ROS 1 ModelStates source used by
     uav_control.  The topic is bridged back to /gazebo/model_states by the
     original uav_gazebo/launch/spawn.launch file when control is enabled. -->
<plugin filename="gz-sim-odometry-publisher-system"
        name="gz::sim::systems::OdometryPublisher">
  <odom_frame>odom</odom_frame>
  <robot_base_frame>tilt_tricopter_base::base</robot_base_frame>
  <dimensions>3</dimensions>
  <odom_topic>/model/tilt_tricopter/odometry</odom_topic>
</plugin>

<plugin name="ArduRotorTiltTricopter" filename="libArduRotorTiltTricopter.so">
  <fdm_addr>127.0.0.1</fdm_addr>
  <fdm_port_in>9002</fdm_port_in>
  <fdm_port_out>9003</fdm_port_out>
  <modelXYZToAirplaneXForwardZDown>0 0 0 3.141593 0 0</modelXYZToAirplaneXForwardZDown>
  <gazeboXYZToNED>0 0 0 3.141593 0 0</gazeboXYZToNED>
  <motor_num>6</motor_num>
  <servo_num>3</servo_num>
  <motor_pub>/gazebo/command/prop_speed</motor_pub>
  <servo1_pub>/gazebo/command/tilt1_pos</servo1_pub>
  <frontRodContactForceXTopic>/tilt_tricopter/front_rod/contact_force_x</frontRodContactForceXTopic>
  <frontRodForceTorqueName>front_rod_force_torque</frontRodForceTorqueName>
  <adm002UdpBindAddr>127.0.0.1</adm002UdpBindAddr>
  <adm002UdpBindPort>9024</adm002UdpBindPort>
  <adm002ForceScale>1.0</adm002ForceScale>
  <adm002StreamRateHz>100.0</adm002StreamRateHz>
  <rangefinderName>front_rangefinder</rangefinderName>
  <rangefinderUdpBindAddr>127.0.0.1</rangefinderUdpBindAddr>
  <rangefinderUdpBindPort>9025</rangefinderUdpBindPort>
  <rangefinderMinDistanceM>0.05</rangefinderMinDistanceM>
  <rangefinderMaxDistanceM>10.0</rangefinderMaxDistanceM>
  <rangefinderRateHz>50.0</rangefinderRateHz>
  <imuName>tilt_tricopter_base::imu_link::imu_sensor</imuName>
  <connectionTimeoutMaxCount>5</connectionTimeoutMaxCount>
</plugin>

<plugin name="imu_plugin" filename="librotors_gazebo_imu_plugin.so">
  <robotNamespace>tilt_tricopter</robotNamespace>
  <linkName>tilt_tricopter_base::imu_link</linkName>
  <imuTopic>imu</imuTopic>
  <gyroscopeNoiseDensity>0.000349</gyroscopeNoiseDensity>     <!-- rad/s/√Hz -->
  <gyroscopeBiasRandomWalk>0.000266</gyroscopeBiasRandomWalk>          <!-- rad/s²/√Hz -->
  <gyroscopeBiasCorrelationTime>600</gyroscopeBiasCorrelationTime> <!-- s -->
  <gyroscopeTurnOnBiasSigma>0.0004</gyroscopeTurnOnBiasSigma>  <!-- rad/s -->
  <accelerometerNoiseDensity>0.00324</accelerometerNoiseDensity> <!-- m/s²/√Hz -->
  <accelerometerRandomWalk>0.0056</accelerometerRandomWalk>     <!-- m/s³/√Hz -->
  <accelerometerBiasCorrelationTime>600</accelerometerBiasCorrelationTime> <!-- s -->
  <accelerometerTurnOnBiasSigma>0.016</accelerometerTurnOnBiasSigma> <!-- m/s² -->
</plugin>


</model>
</sdf>
