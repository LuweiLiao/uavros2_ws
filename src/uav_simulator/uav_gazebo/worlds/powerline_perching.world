<?xml version="1.0"?>
<sdf version="1.10">
  <world name="powerline_perching">
    <gravity>0 0 -9.81</gravity>
    <physics name="contact_physics" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-contact-system" name="gz::sim::systems::Contact"/>
    <scene><ambient>0.65 0.65 0.65 1</ambient><background>0.82 0.88 0.94 1</background><shadows>true</shadows></scene>
    <light name="sun" type="directional">
      <pose>0 0 8 0 0 0</pose><diffuse>0.8 0.8 0.8 1</diffuse><specular>0.2 0.2 0.2 1</specular>
      <direction>-0.3 0.4 -1</direction><cast_shadows>true</cast_shadows>
      <attenuation><range>1000</range><constant>0.9</constant><linear>0.01</linear><quadratic>0.001</quadratic></attenuation>
    </light>
    <model name="ground">
      <static>true</static><link name="ground_link">
        <collision name="ground_collision"><geometry><plane><normal>0 0 1</normal><size>20 20</size></plane></geometry></collision>
        <visual name="ground_visual"><geometry><plane><normal>0 0 1</normal><size>20 20</size></plane></geometry><material><ambient>0.65 0.68 0.70 1</ambient><diffuse>0.65 0.68 0.70 1</diffuse></material></visual>
      </link>
    </model>
    <!-- Rigid, unenergized geometric contact fixture; wire runs along X. -->
    <model name="test_wire">
      <static>true</static><pose>0 0 1.6 0 0 0</pose><link name="wire_link">
        <collision name="wire_collision"><pose>0 0 0 0 1.57079632679 0</pose><geometry><cylinder><radius>0.012</radius><length>4</length></cylinder></geometry><surface><friction><ode><mu>0.65</mu><mu2>0.65</mu2></ode></friction></surface></collision>
        <visual name="wire_visual"><pose>0 0 0 0 1.57079632679 0</pose><geometry><cylinder><radius>0.012</radius><length>4</length></cylinder></geometry><material><ambient>0.95 0.47 0.08 1</ambient><diffuse>0.95 0.47 0.08 1</diffuse></material></visual>
      </link>
    </model>
    <model name="wire_stands">
      <static>true</static><link name="stands">
        <visual name="left"><pose>-1.85 0 0.79 0 0 0</pose><geometry><box><size>0.09 0.09 1.58</size></box></geometry><material><diffuse>0.28 0.31 0.35 1</diffuse></material></visual>
        <collision name="left_collision"><pose>-1.85 0 0.79 0 0 0</pose><geometry><box><size>0.09 0.09 1.58</size></box></geometry></collision>
        <visual name="right"><pose>1.85 0 0.79 0 0 0</pose><geometry><box><size>0.09 0.09 1.58</size></box></geometry><material><diffuse>0.28 0.31 0.35 1</diffuse></material></visual>
        <collision name="right_collision"><pose>1.85 0 0.79 0 0 0</pose><geometry><box><size>0.09 0.09 1.58</size></box></geometry></collision>
      </link>
    </model>
    <!-- Starts 30 mm above saddle contact, already aligned. No flight controller. -->
    <include><uri>model://powerline_perching</uri><name>powerline_perching</name><pose>0 0 1.242 0 0 0</pose></include>
  </world>
</sdf>
