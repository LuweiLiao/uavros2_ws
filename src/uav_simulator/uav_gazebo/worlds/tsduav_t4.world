<?xml version="1.0" ?>
<sdf version="1.10">
  <world name="outdoor">

    <!-- Use Harmonic's complete default GUI. Classic's gui/camera element
         is not the Gazebo Sim camera configuration API. -->


    <!-- Only one ROS interface plugin is required per world, as any other plugin can connect a Gazebo
         topic to a ROS topic (or vise versa). -->
    <plugin name="ros_interface_plugin" filename="librotors_gazebo_ros_interface_plugin.so"/>
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics" />
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu" />
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster" />

    <physics type="ode">
      <ode>
        <solver>
          <type>quick</type>
          <iters>100</iters>
          <sor>1.0</sor>
        </solver>
        <constraints>
          <cfm>0.0</cfm>
          <erp>0.2</erp>
          <contact_max_correcting_vel>0.1</contact_max_correcting_vel>
          <contact_surface_layer>0.0</contact_surface_layer>
        </constraints>
      </ode>
      <real_time_update_rate>-1</real_time_update_rate> <!--  即模拟时间与实时的比率 -->
    </physics>
    <gravity>0 0 -9.8</gravity>
    
    <!-- Classic's implicit sun/ground resources, at their original names. -->
    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
        <range>1000</range><constant>0.9</constant>
        <linear>0.01</linear><quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.5 0.1 -0.9</direction>
    </light>
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry>
          <surface>
            <friction><ode><mu>100</mu><mu2>50</mu2></ode></friction>
            <contact><collide_bitmask>0xffff</collide_bitmask></contact>
          </surface>
        </collision>
        <visual name="visual">
          <cast_shadows>false</cast_shadows>
          <geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry>
          <material>
            <ambient>0.3 0.3 0.3 1</ambient><diffuse>0.7 0.7 0.7 1</diffuse>
            <specular>0.01 0.01 0.01 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <model name="tsduav_t4">
      <!-- Approved ROS2 initial-condition exception: 0.85 m clears the original
           suspended-link collision mesh; let the unchanged model settle. -->
      <pose>0 0 0.85 0 0 0</pose>
      <include>
        <uri>model://tsduav_t4</uri>
        <name>tsduav_t4</name>
      </include>
    </model>

    <!-- Disabled during T4 takeoff tuning; re-enable for obstacle/contact tests.
    <model name="tsd_electric_tower_instance">
      <pose>0 0 0 0 0 0</pose>
      <include>
        <uri>model://tsd_electric_tower</uri>
        <name>tsd_electric_tower</name>
      </include>
    </model>

    <model name="tsd_tree_obstacle_instance">
      <pose>5 0 0 0 0 0</pose>
      <include>
        <uri>model://tsd_tree_obstacle</uri>
        <name>tsd_tree_obstacle</name>
      </include>
    </model>

    <model name="balll">
      <static>true</static>
      <pose>10 0 0 0 0 0</pose>
        <link name="balll">
          <pose>0 0 0.0  0 0 0</pose>
          <inertial>
            <pose>0 0 0 0 0 0</pose>
            <mass>300.5</mass>
            <inertia>
              <ixx>10.8133333333333335</ixx>
              <iyy>10.5083333333333334</iyy>
              <izz>10.5083333333333334</izz>
              <ixy>0</ixy>
              <ixz>0</ixz>
              <iyz>0</iyz>
            </inertia>
          </inertial>
          <collision name="balll_collision">
            <pose>0 0 0  0 0 0</pose>
            <geometry>
              <box>
                <size>4 10 5</size>
              </box>
            </geometry>
            <surface>
              <contact>
                <ode/>
              </contact>
              <friction>
                <ode/>
              </friction>
            </surface>
          </collision>
          <visual name="balll_visual">
            <geometry> 
              <box>
                <size>4 10 5</size>
              </box>
            </geometry>
            <material>
              <script>
                <name>Gazebo/Gray</name>
              </script>
            </material>
          </visual>
        </link>
    </model>
    -->


  </world>
</sdf>
